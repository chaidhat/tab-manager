{
  "name": "tab-manager",
  "displayName": "Tab Manager",
  "description": "Worktree-centric window management: one window per worktree, with PR linking, creation from PRs, and changed-file diffs.",
  "version": "0.2.59",
  "publisher": "chaidhat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaidhat/tab-manager.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Tab Manager",
      "properties": {
        "tabManager.repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Absolute paths of the repositories listed in the Root Worktree Manager view. The list is shared by every window, and opening a window on a repository (or one of its worktrees) adds it. Add and remove them from the view itself — `Add Repository…` in its title bar, and the `×` on a repository row. A leading `~` is expanded to your home directory."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tab-manager-root",
          "title": "Root Worktree Manager",
          "icon": "media/layers-dot.svg"
        },
        {
          "id": "tab-manager-sub-worktree",
          "title": "Sub Worktree Manager",
          "icon": "media/layers.svg"
        },
        {
          "id": "tab-manager-sessions",
          "title": "Claude Sessions",
          "icon": "media/claude.svg"
        }
      ]
    },
    "views": {
      "tab-manager-root": [
        {
          "type": "tree",
          "id": "tab-manager.rootWorktrees",
          "name": "Root Worktree Manager"
        }
      ],
      "tab-manager-sub-worktree": [
        {
          "type": "webview",
          "id": "tab-manager.subWorktreePr",
          "name": "Pull Request",
          "when": "tabManager.isSubWorktree"
        },
        {
          "type": "tree",
          "id": "tab-manager.subWorktreeFiles",
          "name": "Files Changed",
          "when": "tabManager.isSubWorktree"
        }
      ],
      "tab-manager-sessions": [
        {
          "type": "tree",
          "id": "tab-manager.claudeSessions",
          "name": "Claude Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tab-manager.rootWorktrees",
        "contents": "Add a repository to manage its worktrees — create them (from scratch or from a PR), and click one to open it in its own window.\n[Add Repository…](command:tabManager.addRepository)"
      },
      {
        "view": "tab-manager.subWorktreeFiles",
        "contents": "No files changed compared to the base branch."
      },
      {
        "view": "tab-manager.claudeSessions",
        "contents": "No Claude Code sessions are running in your repositories.\nSessions appear here on their own, with what each one is doing — and you get a notification when one finishes or asks you something."
      }
    ],
    "commands": [
      {
        "command": "tabManager.newFile",
        "title": "New File...",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.newFolder",
        "title": "New Folder...",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.revealInFinder",
        "title": "Reveal in Finder",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.openToSide",
        "title": "Open to the Side",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.openWith",
        "title": "Open With...",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.cutFile",
        "title": "Cut",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.copyFile",
        "title": "Copy",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.pasteFile",
        "title": "Paste",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.copyPath",
        "title": "Copy Path",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.renameFile",
        "title": "Rename...",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.deleteFile",
        "title": "Delete",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.openDiff",
        "title": "Open Changes",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.deleteWorktree",
        "title": "Delete Worktree",
        "category": "Tab Manager",
        "icon": "$(trash)"
      },
      {
        "command": "tabManager.copyWorktreePath",
        "title": "Copy Worktree Path",
        "category": "Tab Manager",
        "icon": "$(copy)"
      },
      {
        "command": "tabManager.newWorktreeBlank",
        "title": "New Worktree…",
        "category": "Tab Manager",
        "icon": "$(add)"
      },
      {
        "command": "tabManager.newWorktreeForPr",
        "title": "Create Worktree for Pull Request",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.openWorktreeWindow",
        "title": "Open Worktree in New Window",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.refreshWorktrees",
        "title": "Refresh Worktrees",
        "category": "Tab Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "tabManager.addRepository",
        "title": "Add Repository…",
        "category": "Tab Manager",
        "icon": "$(new-folder)"
      },
      {
        "command": "tabManager.removeRepository",
        "title": "Remove Repository",
        "category": "Tab Manager",
        "icon": "$(close)"
      },
      {
        "command": "tabManager.refreshSubWorktree",
        "title": "Refresh",
        "category": "Tab Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "tabManager.switchWorktree",
        "title": "Switch Worktree...",
        "category": "Tab Manager"
      },
      {
        "command": "tabManager.filesExpandAll",
        "title": "Expand All Files",
        "category": "Tab Manager",
        "icon": "$(expand-all)"
      },
      {
        "command": "tabManager.filesCollapseAll",
        "title": "Collapse All Files",
        "category": "Tab Manager",
        "icon": "$(collapse-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tabManager.addRepository",
          "when": "view == tab-manager.rootWorktrees",
          "group": "navigation@1"
        },
        {
          "command": "tabManager.refreshWorktrees",
          "when": "view == tab-manager.rootWorktrees",
          "group": "navigation@2"
        },
        {
          "command": "tabManager.refreshSubWorktree",
          "when": "view == tab-manager.subWorktreePr",
          "group": "navigation"
        },
        {
          "command": "tabManager.filesExpandAll",
          "when": "view == tab-manager.subWorktreeFiles && !tabManager.filesExpanded",
          "group": "navigation"
        },
        {
          "command": "tabManager.filesCollapseAll",
          "when": "view == tab-manager.subWorktreeFiles && tabManager.filesExpanded",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tabManager.switchWorktree",
          "when": "tabManager.isSubWorktree"
        },
        {
          "command": "tabManager.refreshSubWorktree",
          "when": "tabManager.isSubWorktree"
        },
        {
          "command": "tabManager.newFile",
          "when": "false"
        },
        {
          "command": "tabManager.newFolder",
          "when": "false"
        },
        {
          "command": "tabManager.revealInFinder",
          "when": "false"
        },
        {
          "command": "tabManager.openToSide",
          "when": "false"
        },
        {
          "command": "tabManager.openWith",
          "when": "false"
        },
        {
          "command": "tabManager.cutFile",
          "when": "false"
        },
        {
          "command": "tabManager.copyFile",
          "when": "false"
        },
        {
          "command": "tabManager.pasteFile",
          "when": "false"
        },
        {
          "command": "tabManager.copyPath",
          "when": "false"
        },
        {
          "command": "tabManager.copyRelativePath",
          "when": "false"
        },
        {
          "command": "tabManager.renameFile",
          "when": "false"
        },
        {
          "command": "tabManager.deleteFile",
          "when": "false"
        },
        {
          "command": "tabManager.openDiff",
          "when": "false"
        },
        {
          "command": "tabManager.deleteWorktree",
          "when": "false"
        },
        {
          "command": "tabManager.copyWorktreePath",
          "when": "false"
        },
        {
          "command": "tabManager.newWorktreeBlank",
          "when": "false"
        },
        {
          "command": "tabManager.openWorktreeWindow",
          "when": "false"
        },
        {
          "command": "tabManager.filesExpandAll",
          "when": "false"
        },
        {
          "command": "tabManager.filesCollapseAll",
          "when": "false"
        },
        {
          "command": "tabManager.removeRepository",
          "when": "false"
        },
        {
          "command": "tabManager.newWorktreeForPr",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "tabManager.newWorktreeBlank",
          "when": "view == tab-manager.rootWorktrees && viewItem == repo-git",
          "group": "inline@1"
        },
        {
          "command": "tabManager.removeRepository",
          "when": "view == tab-manager.rootWorktrees && viewItem == repo-git",
          "group": "inline@2"
        },
        {
          "command": "tabManager.copyWorktreePath",
          "when": "view == tab-manager.rootWorktrees && viewItem =~ /^worktree/",
          "group": "inline@0"
        },
        {
          "command": "tabManager.deleteWorktree",
          "when": "view == tab-manager.rootWorktrees && viewItem == worktree-closed",
          "group": "inline@2"
        },
        {
          "command": "tabManager.newFile",
          "when": "view == tab-manager.subWorktreeFiles && viewItem == fileDirectory",
          "group": "1_open@1"
        },
        {
          "command": "tabManager.newFolder",
          "when": "view == tab-manager.subWorktreeFiles && viewItem == fileDirectory",
          "group": "1_open@2"
        },
        {
          "command": "tabManager.openToSide",
          "when": "view == tab-manager.subWorktreeFiles && viewItem == fileLeaf",
          "group": "1_open@1"
        },
        {
          "command": "tabManager.openWith",
          "when": "view == tab-manager.subWorktreeFiles && viewItem == fileLeaf",
          "group": "1_open@2"
        },
        {
          "command": "tabManager.revealInFinder",
          "when": "view == tab-manager.subWorktreeFiles && viewItem =~ /^file/",
          "group": "1_open@3"
        },
        {
          "command": "tabManager.cutFile",
          "when": "view == tab-manager.subWorktreeFiles && viewItem =~ /^file/",
          "group": "2_clipboard@1"
        },
        {
          "command": "tabManager.copyFile",
          "when": "view == tab-manager.subWorktreeFiles && viewItem =~ /^file/",
          "group": "2_clipboard@2"
        },
        {
          "command": "tabManager.pasteFile",
          "when": "view == tab-manager.subWorktreeFiles && viewItem == fileDirectory && tabManager.canPaste",
          "group": "2_clipboard@3"
        },
        {
          "command": "tabManager.copyPath",
          "when": "view == tab-manager.subWorktreeFiles && viewItem =~ /^file/",
          "group": "3_path@1"
        },
        {
          "command": "tabManager.copyRelativePath",
          "when": "view == tab-manager.subWorktreeFiles && viewItem =~ /^file/",
          "group": "3_path@2"
        },
        {
          "command": "tabManager.renameFile",
          "when": "view == tab-manager.subWorktreeFiles && viewItem =~ /^file/",
          "group": "4_mutate@1"
        },
        {
          "command": "tabManager.deleteFile",
          "when": "view == tab-manager.subWorktreeFiles && viewItem =~ /^file/",
          "group": "4_mutate@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tab-manager.rootWorktrees.focus",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "!tabManager.isSubWorktree"
      },
      {
        "command": "workbench.view.extension.tab-manager-sub-worktree",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "tabManager.isSubWorktree"
      }
    ],
    "colors": [
      {
        "id": "tabManager.worktreeActive",
        "description": "Root Worktree Manager: the worktree this window is on.",
        "defaults": {
          "light": "#2C68C5",
          "dark": "#2C68C5",
          "highContrast": "#2C68C5",
          "highContrastLight": "#2C68C5"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "npm run compile && npm run lint && npm run format:check",
    "vscode:prepublish": "npm run compile",
    "start": "npm run compile && code --extensionDevelopmentPath=\"$PWD\" --new-window .",
    "package": "vsce package --out build/tab-manager.vsix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "8.62.1"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
